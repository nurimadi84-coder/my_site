# Пример. Скопируйте в .env и заполните свои значения.

# Без логина и пароля (от 8 символов) вход в кабинет закрыт — запасного пароля в коде нет.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=придумайте-надёжный-пароль

# ОБЯЗАТЕЛЬНО. WhatsApp мастерской, 11 цифр с 7 в начале. Без него сервер не запускается, а npm run build падает.
PHONE_E164=77071234567

# Без ключа чат отвечает «Сервис ИИ временно недоступен» и предлагает WhatsApp — шаблонного бота нет.
AI_API_KEY="sk-..."
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Папка с базой и копиями (по умолчанию data/ рядом с server.py). Относительный путь — от папки проекта.
# MEBEL_DATA_DIR=D:\MebelData
# MEBEL_PORT=8780

# Дополнительные папки для резервных копий базы (через ;): другой диск, флешка, OneDrive.
# %OneDrive% раскрывается, только если переменная есть в системе; иначе копия идёт в data/mirrors/MebelBackups и в лог пишется предупреждение.
BACKUP_MIRROR_DIRS=E:\MebelBackups;%OneDrive%\MebelBackups

# 1 — когда посетители приходят через nginx/Caddy/туннель (сервер слушает только 127.0.0.1).
# Тогда лимиты считаются по настоящему IP посетителя, а не один на всех, и cookie входа получает флаг Secure при HTTPS.
# Пусто — только если сервер открыт в сеть напрямую: иначе любой подделает свой IP заголовком.
TRUST_PROXY=1

# Логи: logs/server.log (всё) и logs/error.log (ошибки со стеком). Папка закрыта от доступа через сайт.
